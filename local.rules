alert icmp any any -> any any (msg:"ICMP ping Detected"; sid:1000001; rev:1;)
alert tcp any any -> any 80 (msg:"HTTP Connection Attempt"; sid:1000002; rev:1;)
alert tcp any any -> any any (msg:"Nmap Scan Detected"; flags:S; sid:1000003; rev:1;)
alert tcp any any -> any any (msg:"Possible TCP SYN Detected"; flags:S; threshold:type threshold,track by_src, count 10,seconds 5;sid:1000004; rev:1;)
alert udp any any -> any 53 (msg:"DNS Traffic Detected"; sid:1000005; rev:1;)

